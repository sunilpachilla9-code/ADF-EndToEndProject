					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select * from dbo.factBookings where booking_date > '@{activity('lastload').output.firstRow.lastload}'\n\nAND \nbooking_date <='@{activity('latestload').output.firstRow.latestload}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
